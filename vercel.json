{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "zexx-gpt-ai.html", "use": "@vercel/static" },
    { "src": "zexx-gpt-login.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/index.js" },
    { "src": "/app", "dest": "/zexx-gpt-ai.html" },
    { "src": "/", "dest": "/zexx-gpt-login.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
